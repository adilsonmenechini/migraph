{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MiGraph Page Metadata Schema",
  "description": "Schema for validating MiGraph wiki page frontmatter (13 types)",
  "type": "object",
  "required": ["id", "type", "domain", "tags", "summary"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier (domain.type.slug)",
      "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+\\.[a-z0-9-]+$",
      "examples": ["sre.runbook.incident-response", "kubernetes.pattern.service-mesh"]
    },
    "type": {
      "type": "string",
      "enum": ["source", "topic", "concept", "decision", "query", "synthesis", "entity", "pattern", "runbook", "architecture", "guide", "reference", "example"],
      "description": "Page type (13 unified types)"
    },
    "domain": {
      "type": "string",
      "description": "Knowledge domain/category",
      "pattern": "^[a-z0-9-]+$"
    },
    "category": {
      "type": "string",
      "description": "Knowledge category (IaC, DevOps, AI, or other)",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "description": "Human-readable title"
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "description": "Topic tags for filtering"
    },
    "summary": {
      "type": "string",
      "minLength": 10,
      "maxLength": 200,
      "description": "Brief 1-2 sentence summary"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Alternative names"
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+\\.[a-z0-9-]+$"
      },
      "description": "IDs of related knowledge"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Related knowledge notes ([[wikilinks]])"
    },
    "inputs": {
      "type": "array",
      "description": "Expected inputs for knowledge usage"
    },
    "outputs": {
      "type": "array",
      "description": "Expected outputs from knowledge"
    },
    "source": {
      "type": "string",
      "format": "uri",
      "description": "Source documentation URL"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "deprecated", "archived"],
      "default": "active"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "default": "1.0.0"
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"],
      "default": "medium"
    },
    "created": {
      "type": "string",
      "format": "date",
      "description": "Creation date (YYYY-MM-DD)"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Creation timestamp (legacy alias of created)"
    },
    "updated": {
      "type": "string",
      "format": "date",
      "description": "Last update date (YYYY-MM-DD)"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last update timestamp (legacy alias of updated)"
    },
    "quality_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Quality score (0-100)"
    }
  }
}
